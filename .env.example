# Copy to .env (git-ignored) for docker compose. Never commit .env.
# On volta, Coolify holds these as app env vars. Every value below is a placeholder.
# STB: COMPOSE_PROFILES=tunnel starts the cloudflared container (needs TUNNEL_TOKEN).
# volta / local: leave COMPOSE_PROFILES empty.
COMPOSE_PROFILES=
TUNNEL_TOKEN=
GATEWAY_PORT=8080
IMAGE_REGISTRY=ghcr.io/snailsquid
IMAGE_TAG=latest
RUST_LOG=info

# Group API keys for X-API-Key, as name:key pairs (add integration:<key> for the off-STB
# Layanan Integrasi, which uses it as its KOTASIAGA_API_KEY) (each key at least 16 random characters).
# One key per group so it can be revoked alone. Generate with: openssl rand -hex 16
API_KEYS=tourism:CHANGE_ME_16_CHARS_MIN,health:CHANGE_ME_16_CHARS_MIN,app:CHANGE_ME_16_CHARS_MIN
# Admin key for /_mock/* demo controls (at least 16 characters).
ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# User JWTs: identity-service signs, core-service verifies. Same value for both, >= 32 chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# The documented test account (Tugas Besar: "satu akun uji"). Seeded or reset at every start.
TEST_ACCOUNT_EMAIL=penguji@kotasiaga.test
TEST_ACCOUNT_NAME=Akun Uji KotaSiaga
TEST_ACCOUNT_PASSWORD=CHANGE_ME_TEST_PASSWORD

# Mock mode (AGENTS.md section 7)
MOCK_MODE=false
MOCK_TICK_SECONDS=5
MOCK_TIME_SCALE=60
# MOCK_SEED=12345
# Partner mocks (in the partner's own format). Unset = follow MOCK_MODE (AGENTS.md section 7:
# in mock mode every external input is generated). Set false to call a live partner even in
# MOCK_MODE; set true to mock it in live mode. A partner without a base URL is always mocked.
# MOCK_UPSTREAM_TOURISM=
# MOCK_UPSTREAM_HEALTH=
# true = ask the real OSRM for road geometry even in MOCK_MODE (risk stays mock-driven).
OSRM_IN_MOCK=false

# External APIs (adapters). Defaults shown; partners stay mocked until a base URL is set.
# OPEN_METEO_URL=https://api.open-meteo.com
# PETABENCANA_URL=https://data.petabencana.id
# OSRM_URL=https://router.project-osrm.org
# TOURISM_BASE_URL=https://chitatomigoreng.stei.site/api
# TOURISM_API_KEY=
# HEALTH_BASE_URL=https://donorkita.stei.site/api
# HEALTH_EVENTS_PATH=/donation-events
# HEALTH_API_KEY=
# UPSTREAM_TIMEOUT_MS=5000
# WEATHER_REFRESH_SECONDS=600
# DISASTER_REFRESH_SECONDS=300
# PARTNER_REFRESH_SECONDS=300
