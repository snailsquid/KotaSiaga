{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/sync-agents-md.sh\" \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 45,
            "statusMessage": "Syncing AGENTS.md from Google Drive..."
          }
        ]
      }
    ]
  }
}
