# Copy to .env (git-ignored). Never commit real values.

# mock = in-app mock backend (default). http = real Smart City API at EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_API_MODE=mock
# Release builds must use HTTPS. Name pending in the API Registry.
EXPO_PUBLIC_API_BASE_URL=https://kotasiaga.stei.site/api
EXPO_PUBLIC_POLL_SECONDS=5

# Mock generator (AGENTS.md section 7)
EXPO_PUBLIC_MOCK_TICK_SECONDS=5
EXPO_PUBLIC_MOCK_TIME_SCALE=60
# EXPO_PUBLIC_MOCK_SEED=42
# true = use the phone's GPS. Default in mock mode: a fixed point in Bandung.
EXPO_PUBLIC_USE_DEVICE_LOCATION=false

# Google sign-in (public OAuth client IDs). Leave empty to use the simulated test account.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Build-time only, read by app.config.js. Secret: keep out of git.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
