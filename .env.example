# Copy to .env on the STB. Never commit .env. On volta, Coolify holds these as app env vars.
# STB: COMPOSE_PROFILES=tunnel starts the cloudflared container (needs TUNNEL_TOKEN).
# volta: leave COMPOSE_PROFILES unset; traffic arrives via the Coolify domain kotasiaga.arkk.dev.
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=
GATEWAY_PORT=8080
IMAGE_REGISTRY=ghcr.io/snailsquid
IMAGE_TAG=latest
RUST_LOG=info

# Mock mode (AGENTS.md section 7)
MOCK_MODE=false
MOCK_TICK_SECONDS=5
MOCK_TIME_SCALE=60
# MOCK_SEED=12345
MOCK_UPSTREAM_TOURISM=false
MOCK_UPSTREAM_HEALTH=false
