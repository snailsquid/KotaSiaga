# Layanan Integrasi (off-STB). Copy to .env.integration (git-ignored). Never commit real keys.
# On volta, Coolify holds these as the app's environment variables.
RUST_LOG=info
INTEGRATION_PORT=8090
IMAGE_REGISTRY=ghcr.io/snailsquid
IMAGE_TAG=latest

# KotaSiaga microservice on the STB, and the group key it issued to this service (API_KEYS on
# the STB, e.g. integration:<key>). Used for risk lookups, routes and keyed reads.
KOTASIAGA_BASE_URL=https://2bintang1hati.stei.site/api
KOTASIAGA_API_KEY=

# Tourism: JelajahLokal. The X-API-Key they issued to KotaSiaga.
TOURISM_BASE_URL=https://chitatomigoreng.stei.site/api
TOURISM_API_KEY=

# Health: DonorKita. The X-API-Key they issued to KotaSiaga (only GET /donation-events is used).
HEALTH_BASE_URL=https://donorkita.stei.site/api
HEALTH_API_KEY=

# Keys for server-to-server callers of THIS service (name:key, >= 16 random chars each).
# The mobile app does not need one: it sends the user's KotaSiaga JWT. openssl rand -hex 16
API_KEYS=
# Admin key for /api/_mock/* (MOCK_MODE only). openssl rand -hex 16
ADMIN_API_KEY=

# Mock mode (AGENTS.md section 7). MOCK_MODE=true mocks both partners in their real format
# unless MOCK_UPSTREAM_* is set explicitly; a partner without a base URL is always mocked.
MOCK_MODE=false
# MOCK_UPSTREAM_TOURISM=true
# MOCK_UPSTREAM_HEALTH=true
# MOCK_SEED=12345

# Tunables (defaults shown)
# UPSTREAM_TIMEOUT_MS=5000
# PARTNER_REFRESH_SECONDS=300
# RISK_REFRESH_SECONDS=30
# RATE_LIMIT_PER_MINUTE=600
