# Copy to .env on the STB. Never commit .env.
TUNNEL_TOKEN=
IMAGE_REGISTRY=ghcr.io/OWNER
IMAGE_TAG=latest
RUST_LOG=info

# Group API keys for X-API-Key, as name:key pairs (each key at least 16 random characters).
# Generate with: openssl rand -hex 16
API_KEYS=tourism:CHANGE_ME,health:CHANGE_ME,app:CHANGE_ME
# Admin key for /_mock/* demo controls.
ADMIN_API_KEY=

# Mock mode (AGENTS.md section 7)
MOCK_MODE=false
MOCK_TICK_SECONDS=5
MOCK_TIME_SCALE=60
# MOCK_SEED=12345
MOCK_UPSTREAM_TOURISM=false
MOCK_UPSTREAM_HEALTH=false
